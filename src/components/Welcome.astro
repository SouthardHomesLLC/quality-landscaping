---
// src/components/Welcome.astro
import WhyUs from "./WhyUs.astro";
import GalleryDisplay from "@components/gallery-display.astro";
import TrustBanner from "./TrustBanner.astro";
import TeamDisplay from "@components/TeamDisplay.astro";
---

<div id="container" class="px-4 py-16 text-center md:py-20">
  <!-- Hero Section -->
  <section id="hero" class="max-w-3xl mx-auto">
    <!-- Premium Glass Backing Panel for Flawless Readability over Background Images -->
    <div
      class="bg-[#D1D5BE]/60 backdrop-blur-lg rounded-3xl p-8 md:px-14 md:py-10
        shadow-xl border border-white/40 max-w-2xl mx-auto"
    >
      <!-- Main SEO Heading enriched with location and service tags -->
      <h1 class="mb-6 font-black tracking-tight leading-none">
        <span
          class="block text-4xl text-[#D9744B] drop-shadow-[0_2px_2px_rgba(255,255,255,0.8)] md:text-6xl"
        >
          Quality Landscape & Leisure
        </span>

        <span
          class="mt-4 block text-lg font-bold leading-snug text-[#2F4340] md:text-xl"
        >
          Landscaping and Hardscaping in Terre Haute, Indiana
        </span>
      </h1>

      <!-- Subtitle Descriptor with geographic anchor -->
      <p
        class="mb-8 text-xl font-bold tracking-wide text-[#2F4340] drop-shadow-[0_1px_1px_rgba(255,255,255,0.6)] md:text-2xl"
      >
        Outdoor design, construction, and property care throughout the Wabash
        Valley.
      </p>

      <!-- Dynamic Call to Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="/contact"
          class="w-full sm:w-auto bg-[#2F4340] text-white
              font-bold px-8 py-3.5 rounded-xl shadow-md
              hover:bg-[#D9744B] hover:border-slate-200 hover:border
              transition-colors duration-200 text-base"
        >
          Get a Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Services Card -->
  <section id="services-preview" class="max-w-5xl mx-auto mt-16 px-4">
    <div
      class="bg-[#D1D5BE]/60 backdrop-blur-lg rounded-3xl p-8 md:p-14
        shadow-xl border border-white/40 max-w-4xl mx-auto mt-12"
    >
      <div class="text-center mb-4">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#2F4340] tracking-tight"
        >
          Services
        </h2>
        <div class="w-34 h-1 bg-[#D9744B] mx-auto mt-2 rounded-full mb-6"></div>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"
      >
        {
          [
            {
              title: "Hardscaping",
              desc: "Custom patios, decks, pergolas, and inviting outdoor living spaces.",
            },
            {
              title: "Landscape Design",
              desc: "Flower services, hedge trimming, planting care, and landscape improvements.",
            },
            {
              title: "Property Maintenance",
              desc: "Seasonal cleanups, pruning, lawn treatments, and landscape maintenance.",
            },
            {
              title: "Outdoor Leisure",
              desc: "LED landscape lighting, patios, pergolas, and backyard leisure features.",
            },
          ].map((service) => (
            <div
              class="bg-white/70 backdrop-blur-sm p-6 
              rounded-2xl border border-white/40 shadow-sm text-left 
              flex flex-col justify-between
              transition-all duration-300
              hover:-translate-y-2 hover:shadow-xl hover:bg-white/90"
            >
              <div>
                <h3 class="text-xl font-bold text-[#2F4340] mb-2">
                  {service.title}
                </h3>
                <p class="text-sm text-slate-600 font-medium">{service.desc}</p>
              </div>
              <a
                href="/services"
                class="mt-4 inline-block text-xs font-bold 
                uppercase tracking-wider text-white 
                bg-[#2F4340] px-4 py-2 rounded-lg 
                hover:bg-[#D9744B] transition-colors duration-200 text-center"
              >
                Learn More
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trust Banner -->
  <TrustBanner />

  <!-- Why Us Content -->
  <section id="why-us" class="max-w-5xl mx-auto mt-16 px-4">
    <div
      class="bg-[#D1D5BE]/60 backdrop-blur-lg rounded-3xl
        p-8 md:p-14 shadow-xl border border-white/40 max-w-4xl mx-auto"
    >
      <div class="text-center mb-6">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#2F4340] tracking-tight"
        >
          Why Choose Us?
        </h2>
        <div class="w-70 h-1 bg-[#D9744B] mx-auto mt-2 rounded-full"></div>
      </div>
      <WhyUs />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-10" id="gallery-preview">
    <!-- Gallery Preview -->
    <div
      class="max-w-6xl mx-auto text-center mb-10 overflow-hidden
        rounded-2xl bg-[#D1D5BE]/80 backdrop-blur-md p-8 md:p-12 border-white/40 border"
    >
      <h2 class="text-3xl md:text-4xl font-bold text-[#2F4340] mb-3">
        Recent Projects
      </h2>
      <div class="w-70 h-1 bg-[#D9744B] mx-auto mt-2 rounded-full mb-6"></div>
      <p class="text-[#2F4340] font-semibold pb-4">
        Browse a selection of landscaping, hardscaping, and outdoor living
        projects completed throughout Terre Haute and the Wabash Valley.
      </p>

      <GalleryDisplay limit={6} columns={2} />

      <div class="mt-10">
        <a
          href="/gallery"
          class="inline-flex items-center justify-center
            bg-[#2F4340] text-white font-bold
            px-8 py-3.5 rounded-xl shadow-md
            hover:bg-[#D9744B] hover:border hover:border-white
            transition-colors duration-200"
        >
          Explore Our Project Gallery
        </a>
      </div>
    </div>
  </section>

  <!-- Extra Content -->
  <section id="about-preview">
    <div
      class="max-w-6xl mx-auto text-center mb-10 overflow-hidden
        rounded-2xl bg-[#D1D5BE]/80 backdrop-blur-md p-8 md:p-12 border-white/40 border"
    >
      <h2 class="text-3xl md:text-4xl font-bold text-[#2F4340] mb-3">
        Landscaping & Hardscaping Services in Terre Haute
      </h2>

      <div class="w-96 h-1 bg-[#D9744B] mx-auto mt-2 rounded-full mb-6"></div>

      <p class="font-semibold mb-3 text-[#2F4340]">
        Quality Landscape and Leisure proudly provides landscaping, hardscaping,
        lawn maintenance, retaining walls, patios, landscape lighting, and
        outdoor living solutions throughout Terre Haute and the Wabash Valley.
      </p>

      <p class="font-semibold text-[#2F4340]">
        Whether you're improving curb appeal, creating a backyard entertainment
        space, or maintaining a commercial property, our team delivers
        dependable craftsmanship and personalized service on every project.
      </p>
    </div>
  </section>

  <!-- Team Section -->
  <section id="team-preview">
    <div
      class="max-w-3xl mx-auto text-center mb-10 overflow-hidden
        rounded-2xl bg-[#D1D5BE]/80 backdrop-blur-md p-8 md:p-12 border-white/40 border"
    >
      <h2 class="text-3xl md:text-4xl font-bold text-[#2F4340] mb-3">
        Our Team
      </h2>
      <div class="w-45 h-1 bg-[#D9744B] mx-auto mt-2 rounded-full mb-6"></div>

      <TeamDisplay />
    </div>
  </section>
</div>
