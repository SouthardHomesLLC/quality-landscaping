---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import companiesLogo from "@assets/logos/quality-companies.png";
import monarchLogo from "@assets/logos/Monarch.png";
import { businessData, sisterCompanies } from "../data/BusinessData";

const year = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-white/20 bg-[#D1D5BE] px-6 py-12 text-[#2F4340]"
>
  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-start gap-12 md:grid-cols-2"
  >
    <div class="flex flex-col items-center md:items-start">
      <div class="flex w-full max-w-xs flex-col items-start md:pl-4">
        <div class="mb-4 w-48">
          <Image
            src={companiesLogo}
            alt="Quality Companies of Indiana"
            width={192}
            height={74}
            class="h-auto w-full object-contain"
            loading="lazy"
          />
        </div>

        <nav
          class="w-full border-l-2 border-white/60 py-1 pl-4"
          aria-label="Quality family of companies"
        >
          <ul
            class="flex flex-col space-y-2 text-lg font-bold tracking-wide text-[#2F4340]/90"
          >
            {
              sisterCompanies.map((company) => (
                <li>
                  <a
                    href={company.href}
                    target={company.external ? "_blank" : undefined}
                    rel={company.external ? "noopener noreferrer" : undefined}
                    class:list={[
                      "block transition-colors hover:text-[#D9744B]",
                      !company.external && "font-extrabold",
                    ]}
                  >
                    {company.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md space-y-6 md:mx-0">
      <div class="rounded-2xl border border-white/30 bg-white/30 p-4 shadow-sm">
        <span
          class="mb-3 block text-center text-[10px] font-bold uppercase tracking-widest text-slate-700 md:text-left"
        >
          Connect With Us
        </span>

        <div class="flex items-center justify-center md:justify-start">
          <a
            href={businessData.urls.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow Quality Landscape & Leisure on Facebook"
            class="rounded-xl bg-white p-2.5 text-[#2F4340] shadow-sm transition-colors hover:bg-[#D9744B] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
          >
            <Icon name="mdi:facebook" class="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div
        class="flex items-center gap-4 rounded-2xl border border-white/30 bg-white/30 p-3.5 shadow-sm"
      >
        <a
          href={`tel:${businessData.phone.href}`}
          aria-label="Call Quality Landscape & Leisure"
          class="block shrink-0 rounded-xl bg-white p-2.5 text-[#2F4340] transition-colors hover:bg-[#D9744B] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
        >
          <Icon name="mdi:phone" class="h-5 w-5" aria-hidden="true" />
        </a>

        <div>
          <span
            class="mb-0.5 block text-[10px] font-bold uppercase tracking-widest text-slate-700"
          >
            Call Ray
          </span>

          <a
            href={`tel:${businessData.phone.href}`}
            class="block text-lg font-extrabold transition-colors hover:text-[#D9744B]"
          >
            {businessData.phone.display}
          </a>
        </div>
      </div>

      <div
        class="flex items-center gap-4 rounded-2xl border border-white/30 bg-white/30 p-3.5 shadow-sm"
      >
        <a
          href={`mailto:${businessData.email}`}
          aria-label="Email Quality Landscape & Leisure"
          class="block shrink-0 rounded-xl bg-white p-2.5 text-[#2F4340] transition-colors hover:bg-[#D9744B] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
        >
          <Icon name="mdi:email-outline" class="h-5 w-5" aria-hidden="true" />
        </a>

        <div class="min-w-0">
          <span
            class="mb-0.5 block text-[10px] font-bold uppercase tracking-widest text-slate-700"
          >
            Email Ray
          </span>

          <a
            href={`mailto:${businessData.email}`}
            class="block break-all text-base font-bold transition-colors hover:text-[#D9744B]"
          >
            {businessData.email}
          </a>
        </div>
      </div>

      <div
        class="flex items-center gap-4 rounded-2xl border border-white/30 bg-white/30 p-3.5 shadow-sm"
      >
        <a
          href={businessData.urls.map}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get directions to Quality Landscape & Leisure"
          class="block shrink-0 rounded-xl bg-white p-2.5 text-[#2F4340] transition-colors hover:bg-[#D9744B] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
        >
          <Icon
            name="mdi:map-marker-outline"
            class="h-5 w-5"
            aria-hidden="true"
          />
        </a>

        <div>
          <span
            class="mb-0.5 block text-[10px] font-bold uppercase tracking-widest text-slate-700"
          >
            Visit Our Office
          </span>

          <address class="not-italic">
            <a
              href={businessData.urls.map}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-sm font-bold leading-snug transition-colors hover:text-[#D9744B]"
            >
              {businessData.address.street}<br />
              {businessData.address.city}, {businessData.address.state}{" "}
              {businessData.address.postalCode}
            </a>
          </address>
        </div>
      </div>
    </div>
  </div>

  <div
    class="mt-12 border-t border-dashed border-[#2F4340]/20 pt-6 text-center text-xs font-medium text-slate-700"
  >
    &copy; {year}{" "}
    {businessData.legalName}. All rights reserved.
  </div>

  <div
    class="flex items-center justify-center pt-4 text-xs font-semibold text-gray-600"
  >
    <span>Website by</span>

    <a
      href="https://monarchmediallc.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit Monarch Media LLC"
      class="ml-1.5 inline-flex transition-opacity hover:opacity-80"
    >
      <Image
        src={monarchLogo}
        alt="Monarch Media LLC"
        width={148}
        height={16}
        loading="lazy"
        class="h-4 w-37 object-contain drop-shadow-sm brightness-95"
      />
    </a>
  </div>
</footer>
