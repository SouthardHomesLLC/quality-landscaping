---
// src/components/navbar/navbar.astro

import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Image } from "astro:assets";
import logoImg from "@assets/logos/logo.jpg";

interface MenuItem {
  title: string;
  path: string;
}

const menuItems: MenuItem[] = [
  {
    title: "Home",
    path: "/",
  },
  {
    title: "About Us",
    path: "/about/",
  },
  {
    title: "Services",
    path: "/services/",
  },
  {
    title: "Gallery",
    path: "/gallery/",
  },
  {
    title: "Contact",
    path: "/contact/",
  },
];

const currentPath = Astro.url.pathname;

const normalizePath = (path: string) =>
  path === "/" ? path : `${path.replace(/\/+$/, "")}/`;

const normalizedCurrentPath = normalizePath(currentPath);

const isActive = (path: string) => {
  const normalizedPath = normalizePath(path);

  return normalizedPath === "/"
    ? normalizedCurrentPath === "/"
    : normalizedCurrentPath === normalizedPath ||
        normalizedCurrentPath.startsWith(normalizedPath);
};

const getLinkClasses = (path: string) =>
  [
    "flex items-center rounded-lg px-3 py-2 font-medium transition-colors",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B]",
    "focus-visible:ring-offset-2 focus-visible:ring-offset-[#D1D5BE]",
    isActive(path)
      ? "bg-[#2F4340] text-white"
      : "text-[#2F4340] hover:bg-white/40 hover:text-[#D9744B]",
  ].join(" ");
---

<header class="w-full border-b border-white/30 bg-[#D1D5BE]/90">
  <div class="mx-auto max-w-5xl px-6">
    <Astronav>
      <div class="flex w-full items-center justify-between py-2">
        <a
          href="/"
          id="logo-link"
          aria-label="Quality Landscape and Leisure home"
          class="flex items-center rounded-full transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
        >
          <Image
            src={logoImg}
            width={80}
            height={80}
            alt="Quality Landscape and Leisure"
            id="logo"
            class="h-20 w-auto rounded-full object-contain opacity-90 brightness-115"
            loading="eager"
          />
        </a>

        <div class="lg:hidden">
          <MenuIcon
            class="h-8 w-8 cursor-pointer text-[#2F4340] transition-colors duration-200 hover:text-[#D9744B]"
            aria-label="Toggle navigation menu"
          />
        </div>

        <MenuItems
          class="hidden w-full pb-4 lg:flex lg:w-auto lg:items-center lg:pb-0"
        >
          <nav class="w-full" aria-label="Main navigation">
            <ul
              class="flex flex-col items-end gap-2 lg:flex-row lg:items-center lg:gap-2"
            >
              {
                menuItems.map((item) => {
                  const active = isActive(item.path);

                  return (
                    <li>
                      <a
                        href={item.path}
                        class={getLinkClasses(item.path)}
                        aria-current={active ? "page" : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
        </MenuItems>
      </div>
    </Astronav>
  </div>
</header>
