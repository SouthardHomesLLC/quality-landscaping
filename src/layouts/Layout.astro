---
import { SEO } from "astro-seo";
import { Image } from "astro:assets";

import FooterContent from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import background from "@assets/background.webp";
import { businessData } from "@data/BusinessData";

import "@styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = businessData.description,
  canonical,
  image = "/opengraph.jpg",
  noindex = false,
} = Astro.props;

if (!Astro.site) {
  throw new Error(
    "Astro.site must be configured in astro.config.mjs to generate canonical URLs.",
  );
}

const siteName = businessData.name;

const pageTitle = title
  ? `${title} | ${siteName}`
  : "Landscaping Services in Terre Haute, IN | Quality Landscape & Leisure";

const canonicalURL = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

const socialImageURL = new URL(image, Astro.site).toString();
const logoURL = new URL("/logo.jpg", Astro.site).toString();
const businessURL = new URL("/", Astro.site).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${businessURL}#business`,
  name: businessData.name,
  legalName: businessData.legalName,
  url: businessURL,
  telephone: businessData.phone.schema,
  email: businessData.email,
  logo: logoURL,
  image: socialImageURL,
  description: businessData.description,
  sameAs: [businessData.urls.facebook],
  hasMap: businessData.urls.map,

  address: {
    "@type": "PostalAddress",
    streetAddress: businessData.address.street,
    addressLocality: businessData.address.city,
    addressRegion: businessData.address.state,
    postalCode: businessData.address.postalCode,
    addressCountry: businessData.address.country,
  },

  geo: {
    "@type": "GeoCoordinates",
    latitude: businessData.geo.latitude,
    longitude: businessData.geo.longitude,
  },

  openingHoursSpecification: businessData.hours.map((hours) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: hours.days,
    opens: hours.opens,
    closes: hours.closes,
  })),

  areaServed: businessData.serviceAreas.map((area) =>
    area.type === "City"
      ? {
          "@type": "City",
          name: area.name,
          containedInPlace: {
            "@type": "State",
            name: area.region,
          },
        }
      : {
          "@type": "AdministrativeArea",
          name: area.name,
        },
  ),

  knowsAbout: businessData.services,
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta name="generator" content={Astro.generator} />

    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalURL}
      extend={{
        meta: [
          {
            name: "robots",
            content: noindex
              ? "noindex, nofollow"
              : "index, follow, max-image-preview:large",
          },
        ],
      }}
      twitter={{
        card: "summary_large_image",
        title: pageTitle,
        description,
        image: socialImageURL,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: pageTitle,
          image: socialImageURL,
        },
        optional: {
          description,
          siteName,
          locale: "en_US",
        },
        image: {
          alt: `${siteName} landscaping services in Terre Haute, Indiana`,
        },
      }}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <script
      is:inline
      data-goatcounter="https://qualitylandscapeandleisure.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </head>

  <body class="relative flex min-h-screen flex-col overflow-x-hidden">
    <div
      class="pointer-events-none fixed inset-0 z-0 scale-105 overflow-hidden"
      aria-hidden="true"
    >
      <Image
        src={background}
        alt=""
        widths={[640, 1200, 1920]}
        sizes="100vw"
        class="h-full w-full select-none object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="relative z-10 flex min-h-screen grow flex-col">
      <Navbar />

      <main class="grow">
        <slot />
      </main>

      <FooterContent />
    </div>
  </body>
</html>
