---
// src/pages/about.astro
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import TeamDisplay from "@components/TeamDisplay.astro";

//Targeted SEO copy configuration suite
const pageMeta = {
  title: "About Our Terre Haute Landscaping Company",
  description:
    "Meet the team behind Quality Landscape & Leisure and learn how we provide dependable landscaping, hardscaping, and property maintenance across the Wabash Valley.",
};
---

<Layout title={pageMeta.title} description={pageMeta.description}>
  <Container>
    <div id="container" class="py-16 md:py-24 space-y-20">
      <section id="hero" class="max-w-4xl mx-auto px-4 text-center">
        <div
          class="bg-white/60 backdrop-blur-sm p-6 md:p-10 rounded-2xl border
             border-white/50 shadow-sm text-lg text-slate-800 font-medium
             leading-relaxed space-y-6 text-left md:text-center"
        >
          <h1
            class="text-4xl md:text-5xl font-extrabold
                text-[#2F4340] tracking-tight mb-2"
          >
            About Quality Landscape & Leisure
          </h1>
          <div class="w-58 h-1 bg-[#D9744B] mx-auto rounded-full"></div>
          <p>
            At <strong>Quality Landscape and Leisure</strong>, we are dedicated
            to transforming your outdoor residential or commercial property into
            an inviting, high-end retreat. From custom hardscapes and landscape
            renovations to routine property maintenance, our standard is
            perfection.
          </p>
          <p>
            Backed by the trusted foundation of our multi-trade Quality family
            of companies serving the Wabash Valley, we bring unmatched
            reliability, structural expertise, and creative landscape design to
            every property we touch.
          </p>
        </div>
      </section>

      <section id="team" class="max-w-4xl mx-auto px-4">
        <div
          class="bg-white/60 backdrop-blur-sm p-6 md:p-10 rounded-2xl border
            border-white/50 shadow-sm text-lg text-slate-800 font-medium
            leading-relaxed space-y-6 text-left md:text-center"
        >
          <div class="text-center mb-12">
            <h2
              class="text-3xl font-extrabold text-[#2F4340] tracking-tight mb-2"
            >
              Meet Our Team
            </h2>
            <div class="w-58 h-1 bg-[#D9744B] mx-auto rounded-full"></div>
          </div>

          <!-- Clean abstracted team view element -->
          <TeamDisplay />
        </div>
      </section>
    </div>
  </Container>
</Layout>
