---
// src/pages/contact.astro

import { Icon } from "astro-icon/components";

import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { businessData } from "../data/BusinessData";

const pageMeta = {
  title: "Contact Our Terre Haute Landscaping Team",
  description:
    "Contact Quality Landscape & Leisure for landscaping, hardscaping, lawn care, irrigation, and outdoor design services in Terre Haute and the Wabash Valley.",
};
---

<Layout title={pageMeta.title} description={pageMeta.description}>
  <Container>
    <div class="mx-auto max-w-3xl px-4 py-12 md:py-24">
      <section
        class="relative z-10 rounded-3xl border border-white/40 bg-[#D1D5BE]/60 p-8 text-center shadow-xl backdrop-blur-md md:p-12"
      >
        <header class="mx-auto mb-10 max-w-2xl">
          <h1
            class="mb-4 text-4xl font-extrabold tracking-tight text-[#2F4340] md:text-5xl"
          >
            Get in Touch
          </h1>

          <p class="text-lg font-medium leading-relaxed text-slate-800">
            Have questions about landscaping, hardscaping, lawn care,
            irrigation, or commercial property maintenance? Contact our Terre
            Haute team to discuss your outdoor project.
          </p>
        </header>

        <div class="mx-auto my-8 max-w-md space-y-6 text-left">
          <!-- Phone -->
          <div
            class="flex items-center gap-5 rounded-2xl border border-white/40 bg-white/40 p-4 shadow-sm transition-colors hover:border-[#2F4340]"
          >
            <a
              href={`tel:${businessData.phone.href}`}
              aria-label={`Call ${businessData.name}`}
              class="block shrink-0 rounded-xl bg-white p-3 text-[#2F4340] shadow-sm transition-colors hover:bg-[#2F4340] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
            >
              <Icon name="mdi:phone" class="h-6 w-6" aria-hidden="true" />
            </a>

            <div>
              <h2
                class="mb-0.5 text-xs font-bold uppercase tracking-wider text-slate-600"
              >
                Call Us
              </h2>

              <a
                href={`tel:${businessData.phone.href}`}
                class="block text-xl font-extrabold text-[#2F4340] transition-colors hover:text-[#D9744B]"
              >
                {businessData.phone.display}
              </a>
            </div>
          </div>

          <!-- Email -->
          <div
            class="flex items-center gap-5 rounded-2xl border border-white/40 bg-white/40 p-4 shadow-sm transition-colors hover:border-[#2F4340]"
          >
            <a
              href={`mailto:${businessData.email}`}
              aria-label={`Email ${businessData.name}`}
              class="block shrink-0 rounded-xl bg-white p-3 text-[#2F4340] shadow-sm transition-colors hover:bg-[#2F4340] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
            >
              <Icon
                name="mdi:email-outline"
                class="h-6 w-6"
                aria-hidden="true"
              />
            </a>

            <div class="min-w-0">
              <h2
                class="mb-0.5 text-xs font-bold uppercase tracking-wider text-slate-600"
              >
                Email Us
              </h2>

              <a
                href={`mailto:${businessData.email}`}
                class="block break-all text-lg font-bold text-[#2F4340] transition-colors hover:text-[#D9744B]"
              >
                {businessData.email}
              </a>
            </div>
          </div>

          <!-- Address -->
          <div
            class="flex items-center gap-5 rounded-2xl border border-white/40 bg-white/40 p-4 shadow-sm transition-colors hover:border-[#2F4340]"
          >
            <a
              href={businessData.urls.map}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Get directions to ${businessData.name}`}
              class="block shrink-0 rounded-xl bg-white p-3 text-[#2F4340] shadow-sm transition-colors hover:bg-[#2F4340] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D9744B] focus-visible:ring-offset-2"
            >
              <Icon
                name="mdi:map-marker-outline"
                class="h-6 w-6"
                aria-hidden="true"
              />
            </a>

            <div>
              <h2
                class="mb-0.5 text-xs font-bold uppercase tracking-wider text-slate-600"
              >
                Visit Our Office
              </h2>

              <address class="not-italic">
                <a
                  href={businessData.urls.map}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-lg font-bold leading-snug text-[#2F4340] transition-colors hover:text-[#D9744B]"
                >
                  {businessData.address.street}<br />
                  {businessData.address.city}, {businessData.address.state}{" "}
                  {businessData.address.postalCode}
                </a>
              </address>
            </div>
          </div>
        </div>

        <div
          class="mt-10 border-t border-dashed border-[#2F4340]/30 pt-6 text-base font-semibold italic text-[#2F4340]"
        >
          We look forward to connecting and planning your project!
        </div>
      </section>
    </div>
  </Container>
</Layout>
